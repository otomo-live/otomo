# COM-9: the shape of deploy/.env. That file is git-ignored; this one is tracked
# and holds no secret.
#
# deploy/scripts/generate-secrets.sh copies this file to deploy/.env and fills in
# every password with 48 hex characters from openssl, which is what makes it safe
# to interpolate those values into SQL, a DSN and a Valkey config without quoting
# games. Do not hand-edit a password to something with a space, a quote or a `$`:
# generate-secrets.sh and up.sh source this file as shell, and Compose parses it
# as an env file, so a value has to satisfy both.
#
# Nothing here is read by a service directly. Compose interpolates these into the
# service environments (see compose.yaml), so this file is the only place a
# deployment's passwords and ports are written down.

# --- Postgres ---------------------------------------------------------------
# The superuser is for the cluster; no service connects as it. COM-6 gives each
# service a role of its own, created by deploy/postgres/init/01-provision.sh.
POSTGRES_SUPERUSER=otomo
POSTGRES_SUPERUSER_PASSWORD=

# One password per role. auth_rw, config_rw and session_rw own auth, config and
# session respectively; patch_ro can read config and write nothing; admin_auth_rw
# owns admin_auth (the staff identity service, services/admin_auth);
# postgres_exporter is monitoring-only: pg_monitor plus CONNECT on
# the `postgres` database, and nothing else.
AUTH_RW_PASSWORD=
CONFIG_RW_PASSWORD=
SESSION_RW_PASSWORD=
PATCH_RO_PASSWORD=
ADMIN_AUTH_RW_PASSWORD=
# allocator_rw owns allocator (services/allocator).
ALLOCATOR_RW_PASSWORD=
POSTGRES_EXPORTER_PASSWORD=

# --- Valkey -----------------------------------------------------------------
# Rendered into deploy/valkey/valkey.conf, which is git-ignored because that is
# where the password ends up.
VALKEY_PASSWORD=

# --- Staff identity (admin-auth) --------------------------------------------
# admin-auth is in this stack (compose.yaml), so its JWKS URL and issuer are
# pinned there rather than here: every staff verifier must agree on them exactly,
# and a variable would let one host disagree with the rest. Nothing to set.

# --- Published ports --------------------------------------------------------
# The only two host ports this stack publishes, both on loopback by default.
# Docker-published ports bypass ufw, so the bind address is the real control:
# set GATEWAY_BIND_ADDR=0.0.0.0 only to put the player edge on the internet
# deliberately. GATEWAY_DEV_PORT is the staff control plane and stays on the
# loopback interface whatever value it has.
GATEWAY_BIND_ADDR=127.0.0.1
GATEWAY_PORT=8080
GATEWAY_DEV_PORT=8090

# --- Image tags -------------------------------------------------------------
# Per-service so one service can be released or rolled back without touching the
# others. `local` means "built on this host, never pushed"; release.sh overwrites
# one of these with a git SHA after it pushes that tag to the registry.
OTOMO_AUTH_TAG=local
OTOMO_SESSION_TAG=local
OTOMO_ADMIN_AUTH_TAG=local
OTOMO_CONFIG_TAG=local
OTOMO_PATCH_TAG=local
OTOMO_DASHBOARD_TAG=local
OTOMO_ADMINUI_TAG=local
OTOMO_GATEWAY_TAG=local
OTOMO_GATEWAY_DEV_TAG=local

# --- Public host -------------------------------------------------------------
# The DNS name players reach this host by: the edge's certificate name, and where
# the Allocator tells clients to find the Gameplay Proxy (UDP GAMEPLAY_PROXY_PORT,
# default 27000).
OTOMO_PUBLIC_HOST=

# --- Public edge -------------------------------------------------
# On the host that owns OTOMO_PUBLIC_HOST, enable the edge with
#   COMPOSE_PROFILES=edge
# and, once deploy/edge/certbot.sh has issued the certificate,
#   OTOMO_PUBLIC_BASE_URL=https://<OTOMO_PUBLIC_HOST>
# EDGE_SITE_URL optionally serves a site at / (e.g. http://wiki-site:8080).
COMPOSE_PROFILES=
OTOMO_PUBLIC_BASE_URL=
EDGE_SITE_URL=

# --- Site -----------------------------------------------------------
# A checkout of the site's content repository (deploy/site/README.md). Enable
# with COMPOSE_PROFILES=edge,site and EDGE_SITE_URL=http://wiki-site:8080.
SITE_CONTENT_DIR=
SITE_CONTENT_BRANCH=main

# --- Game servers ---------------------------------------------------
# The fixed pool gs-1, gs-2 (deploy/gameserver/README.md). Copy the Godot server
# export into deploy/gameserver/build/, then add the profile:
#   COMPOSE_PROFILES=edge,gameservers
OTOMO_GAMESERVER_TAG=local

# --- Technical wiki deploys ------------------------------------------
# A sparse checkout of this repository (docs/ and services/wiki/) that
# deploy/docs/deploy-docs.sh builds from; see deploy/docs/README.md.
DOCS_CONTENT_DIR=
DOCS_BRANCH=staging
