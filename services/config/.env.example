# Config service configuration.
# Copy to .env for local runs. In deployment these arrive through the
# Jenkins credential-backed env file (COM-9); no real secret goes in the repo.

# Public listener. Gateway proxies /api/admin/config/* here, without stripping the
# prefix — this service's routes are registered at their external path.
CONFIG_LISTEN_ADDR=:8080

# Internal listener: /healthz, /readyz, /metrics, /debug/pprof/. Never routed to from
# outside the compose network, and not published by the image.
CONFIG_METRICS_ADDR=:9090

# Required by serve and migrate.
CONFIG_DATABASE_URL=postgres://config_rw:CHANGE_ME@postgres:5432/config

# COM-14 pool budget: keep the sum across services below Postgres max_connections.
CONFIG_DB_MAX_CONNS=8

# Required by serve. Content-addressed blob storage, fanned out as blobs/ab/cd/abcd….
# Must be a volume writable by uid 65532: the service refuses to start otherwise,
# rather than discovering it mid-publish. Note that an *empty named volume* mounted
# here arrives owned by root and will fail that check — set its ownership, or
# bind-mount a directory that already has it.
CONFIG_BLOB_ROOT=/var/lib/otomo/blobs

# Required by serve. The staff identity domain from 06-auth-identity-contract.md §3;
# PHP Admin Auth's JWKS, not Auth's (that one issues player tokens). Both values are
# checked against the token's own claims, never inferred from which JWKS answered.
CONFIG_STAFF_JWKS_URL=http://php-admin/.well-known/jwks.json
CONFIG_STAFF_ISSUER=https://php-admin.otomo.internal
CONFIG_STAFF_AUDIENCE=otomo:staff

# How often the JWKS is re-fetched, and the leeway allowed on exp/nbf. The skew must
# cover the worst clock disagreement between this container and PHP Admin Auth; 0 is
# accepted, for a deployment whose containers share a clock source.
CONFIG_STAFF_JWKS_REFRESH=30s
CONFIG_JWT_CLOCK_SKEW=30s

CONFIG_READ_TIMEOUT=10s
CONFIG_WRITE_TIMEOUT=30s
CONFIG_IDLE_TIMEOUT=120s
CONFIG_SHUTDOWN_TIMEOUT=15s
CONFIG_LOG_LEVEL=info

# The largest content pack POST /packs will accept; design/02-config.md §7 permits
# 512 MiB. Must be positive. The upload handler clears the request's read deadline, so
# this cap, not CONFIG_READ_TIMEOUT, is what bounds a large pack.
CONFIG_MAX_PACK_BYTES=536870912

# Read only by the internal/store tests. Never set this in a deployment.
CONFIG_TEST_DATABASE_URL=
