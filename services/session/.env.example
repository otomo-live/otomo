# Session service configuration.
# Copy to .env for local runs. In deployment these arrive through the
# Jenkins credential-backed env file (COM-9); no real secret goes in the repo.

# Public listener. Gateway proxies /api/player/session/* and /api/admin/session/* here,
# without stripping the prefixes — this service's routes are registered at their external
# paths.
SESSION_LISTEN_ADDR=:8080

# Metrics listener: /healthz, /readyz, /metrics, /debug/pprof/. Never routed to from
# outside the compose network, and not published by the image.
SESSION_METRICS_ADDR=:9090

# Required by serve and migrate. Durable state: profiles, friendships, blocks, parties.
SESSION_DATABASE_URL=postgres://session_rw:CHANGE_ME@postgres:5432/session

# COM-14 pool budget: keep the sum across services below Postgres max_connections.
SESSION_DB_MAX_CONNS=8

# Required by serve. Presence, the pending-event lists and the pub/sub channel that wakes
# a long-poll. The ACL username and password travel in this URL (SES-A3 sets a password on
# the Valkey instance), so it is a secret: keep it in the credential-backed env file, not
# in the compose file. valkey:// and redis:// are both accepted.
SESSION_VALKEY_URL=valkey://default:CHANGE_ME@valkey:6379/0

# Required by serve. The *player* identity domain: Auth's JWKS, not PHP Admin Auth's.
# This service accepts nothing else on /api/player/session/* — a staff token presented
# there is refused, and this is the configuration that makes that true.
SESSION_PLAYER_JWKS_URL=http://auth:8080/.well-known/jwks.json
SESSION_PLAYER_ISSUER=https://auth.otomo.internal
SESSION_PLAYER_AUDIENCE=otomo:player

# Required by serve. The *staff* identity domain, from 06-auth-identity-contract.md §3.
# Only the small admin surface under /api/admin/session is reachable with these tokens.
SESSION_STAFF_JWKS_URL=http://php-admin/.well-known/jwks.json
SESSION_STAFF_ISSUER=https://php-admin.otomo.internal
SESSION_STAFF_AUDIENCE=otomo:staff

# How often each JWKS is re-fetched (one ticker per domain), and the leeway allowed on
# exp/nbf. The skew must cover the worst clock disagreement between this container and the
# issuer; 0 is accepted, for a deployment whose containers share a clock source.
SESSION_JWKS_REFRESH=30s
SESSION_JWT_CLOCK_SKEW=30s

# How long GET /api/player/session/events holds a request open before answering [] (§4
# says 25 s). Must stay below SESSION_READ_TIMEOUT, which must in turn stay below
# Gateway's read timeout for that route (§5a sets 35 s) — startup refuses the combination
# otherwise, because a hold longer than the proxy's timeout turns every idle poll into a
# 504.
SESSION_EVENT_HOLD=25s

# LB-1: session.rules from the server manifest on Patch's internal listener (CF-3),
# polled with its ETag. Leave the key path empty to stay on the compiled-in defaults.
SESSION_PATCH_URL=http://patch:8081
SESSION_PATCH_KEY_PATH=
SESSION_RULES_CHANNEL=live
SESSION_RULES_POLL=60s

# LB-3: lobby launches call the Allocator with allocator_session.key. Leave the key path
# empty and POST /party/launch answers 503 launch_unavailable.
SESSION_ALLOCATOR_URL=http://allocator:8080
SESSION_ALLOCATOR_KEY_PATH=

# LB-4: the Allocator's end-of-match callback, on its own listener. No gateway may point
# at it. The key is session_allocator.key, which the Allocator presents; leave it empty
# and every call to this listener answers 401, so only the 30 s repair poll (which needs
# the Allocator key above) returns a party from its match.
SESSION_INTERNAL_ADDR=:8081
SESSION_CALLBACK_KEY_PATH=

# SE-8 (D5): a player request whose X-Otomo-Release is not the live release answers
# 409 release_outdated. A request without the header is let through while this is false;
# set it to true once the SDK sends the header.
SESSION_REQUIRE_RELEASE_HEADER=false

# WriteTimeout is above ReadTimeout on purpose: it is the budget for writing one answer,
# and the longest answer is a long-poll's, which cannot start until the hold is over.
SESSION_READ_TIMEOUT=35s
SESSION_WRITE_TIMEOUT=40s
SESSION_IDLE_TIMEOUT=120s
SESSION_SHUTDOWN_TIMEOUT=15s
SESSION_LOG_LEVEL=info

# Read only by the integration tests. Never set these in a deployment.
SESSION_TEST_DATABASE_URL=
SESSION_TEST_VALKEY_URL=
