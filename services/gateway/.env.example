# gateway configuration: the player edge.
# Copy to .env for local runs. In deployment these arrive through the
# Jenkins credential-backed env file (COM-9) or deploy/compose.yaml; no real
# secret goes in the repo.

# Public listener: the only address a game client ever hardcodes.
GATEWAY_LISTEN_ADDR=:8080

# Internal listener: /healthz, /readyz, /metrics, /debug/pprof/. Never exposed.
GATEWAY_METRICS_ADDR=:9090

# The player identity domain: services/auth (design/06-auth-identity-contract.md §4).
# The issuer and audience must equal auth's AUTH_ISSUER / AUTH_AUDIENCE and
# session's SESSION_PLAYER_* character for character; a mismatch 401s every
# player request. deploy/scripts/check-compose.sh fails on any drift between this
# file, the other .env.example files and deploy/compose.yaml.
GATEWAY_PLAYER_JWKS_URL=http://auth:8080/.well-known/jwks.json
GATEWAY_PLAYER_ISSUER=https://auth.otomo.internal
GATEWAY_PLAYER_AUDIENCE=otomo:player

# The staff identity domain: admin-auth. Needed here only for the two
# dev/staging patch manifest routes; both domains gate /readyz.
GATEWAY_STAFF_JWKS_URL=http://admin-auth:8080/.well-known/jwks.json
GATEWAY_STAFF_ISSUER=https://admin-auth.otomo.internal
GATEWAY_STAFF_AUDIENCE=otomo:staff

# Upstreams. Every route's target must be present or the process exits at startup.
# /auth/* goes to auth unmodified; /api/player/session/* to session, unstripped.
GATEWAY_UPSTREAM_AUTH_URL=http://auth:8080
GATEWAY_UPSTREAM_PATCH_URL=http://patch:8080
GATEWAY_UPSTREAM_SESSION_URL=http://session:8080

# Per-IP rate limiting (techspec §6.4). /auth/* (unauthenticated token minting)
# uses the stricter login bucket; every other route uses the general one.
GATEWAY_RATE_LIMIT_RPS=20
GATEWAY_RATE_LIMIT_BURST=40
GATEWAY_LOGIN_RATE_LIMIT_RPS=5
GATEWAY_LOGIN_RATE_LIMIT_BURST=10
GATEWAY_SWEEP_INTERVAL=5m
GATEWAY_MAX_IDLE_AGE=10m

# Addresses of the TLS-terminating reverse proxy (the edge) in front of this
# gateway: a comma-separated list of CIDRs or bare IPs. A bare IP becomes a /32
# or /128. Only a request whose TCP peer is in this list may name its client in
# X-Forwarded-For; the rate limiter and access log then key on that client, and
# the header is removed so upstreams cannot re-trust it. Every other peer is
# keyed on its own address, so a spoofed header is ignored.
# Empty (the default) trusts nobody, which is correct when this gateway is
# reached directly rather than through the edge.
GATEWAY_TRUSTED_PROXIES=

# Optional TLS on the public listener. Both or neither.
GATEWAY_TLS_CERT_FILE=
GATEWAY_TLS_KEY_FILE=

GATEWAY_READ_TIMEOUT=10s
GATEWAY_WRITE_TIMEOUT=30s
GATEWAY_IDLE_TIMEOUT=120s

# Leeway on exp/nbf when validating tokens: a token is accepted up to this long
# after its exp, which is why a client can see 401 expired up to 30 s after
# expires_in says the access token ran out.
GATEWAY_JWT_CLOCK_SKEW=30s

# Set to 1 for human-readable logs. Local development only.
GATEWAY_LOG_PRETTY=
