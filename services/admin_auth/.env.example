# Admin-auth service configuration.
# Copy to .env for local runs. In deployment these arrive through the
# Jenkins credential-backed env file (COM-9); no real secret goes in the repo.

# Public listener. Gateway proxies the staff routes here.
ADMIN_AUTH_LISTEN_ADDR=:8080

# Internal listener: /healthz, /readyz, /metrics, /debug/pprof/.
ADMIN_AUTH_METRICS_ADDR=:9090

# Required by serve, migrate and bootstrap-root.
ADMIN_AUTH_DATABASE_URL=postgres://admin_auth_rw:CHANGE_ME@postgres:5432/admin_auth

# COM-14 pool budget: keep the sum across services below Postgres max_connections.
ADMIN_AUTH_DB_MAX_CONNS=8

# Required by serve. PKCS#8 PEM, mounted read-only, readable by uid 65532.
ADMIN_AUTH_SIGNING_KEY_PATH=/run/secrets/admin_auth_signing_key.pem

# Required by serve. One line of base64 standard encoding holding exactly 32 random
# bytes; it seals the staff TOTP secrets. Generate it with:
#   admin-auth genkey --totp /run/secrets/admin_auth_totp.key
# Mounted read-only, chmod 0600.
ADMIN_AUTH_TOTP_KEY_PATH=/run/secrets/admin_auth_totp.key

# Break-glass root password for `bootstrap-root`: mounted read-only, chmod 0600.
# One trailing newline is trimmed; the value must be at least 16 characters.
ADMIN_AUTH_ROOT_PASSWORD_FILE=/run/secrets/admin_root_password

# Must equal GATEWAY_STAFF_ISSUER / GATEWAY_STAFF_AUDIENCE exactly.
ADMIN_AUTH_ISSUER=https://admin-auth.otomo.internal
ADMIN_AUTH_AUDIENCE=otomo:staff

# Staff access-token lifetime. Must be positive and at most 1h.
ADMIN_AUTH_ACCESS_TOKEN_TTL=15m

# Staff refresh-cookie lifetime. Must be positive and at most 720h.
ADMIN_AUTH_REFRESH_TOKEN_TTL=168h

# Window in which replaying an already-rotated refresh cookie is treated as the
# benign multi-tab race rather than theft. Must be >=0 and at most 5m; 0 disables it.
ADMIN_AUTH_REFRESH_REUSE_GRACE=30s

# Staff invite and password-reset link lifetime. Must be between 1h and 168h.
ADMIN_AUTH_INVITE_TTL=72h

# Base URL the admin UI is reached at. Invite and reset links are built as
# <ADMIN_AUTH_PUBLIC_URL>/admin/onboard#token=<token>. The token is in the URL
# fragment, which a browser never sends to a server, so it cannot land in a proxy
# access log or a Referer header.
ADMIN_AUTH_PUBLIC_URL=http://localhost:8090

# Failed logins before the account locks, and how long the lock lasts.
ADMIN_AUTH_LOGIN_MAX_FAILURES=5
ADMIN_AUTH_LOGIN_LOCKOUT=15m

ADMIN_AUTH_READ_TIMEOUT=10s
ADMIN_AUTH_WRITE_TIMEOUT=30s
ADMIN_AUTH_IDLE_TIMEOUT=120s
ADMIN_AUTH_SHUTDOWN_TIMEOUT=15s
ADMIN_AUTH_LOG_LEVEL=info

# Read only by the internal/store tests. Never set this in a deployment.
ADMIN_AUTH_TEST_DATABASE_URL=
