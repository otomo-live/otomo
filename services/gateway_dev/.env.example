# gateway_dev configuration: the admin and dev edge.
# Copy to .env for local runs. In deployment these arrive through the
# Jenkins credential-backed env file (COM-9); no real secret goes in the repo.

# Public listener. The admin UI reaches the service here; this listener must NOT
# be exposed to the internet (common-stack §1), because /admin-auth/ and /admin/
# are unauthenticated by design and the rest is the staff control plane.
GATEWAY_DEV_LISTEN_ADDR=:8080

# Internal listener: /healthz, /readyz, /metrics, /debug/pprof/. Never exposed.
GATEWAY_DEV_METRICS_ADDR=:9090

# Upstreams. Every route's target must be present or the process exits at startup.
# adminui is services/adminui (an nginx image); adminauth, config, dashboard and
# session are Go services/ here. /admin-auth/* and /api/admin/users* both go to
# adminauth. session is the SAME deployment services/gateway proxies to
# /api/player/session/, under a different prefix.
GATEWAY_DEV_UPSTREAM_ADMINAUTH_URL=http://admin-auth:8080
# adminui is served by nginxinc/nginx-unprivileged, which binds 8080: it runs as
# a non-root user (uid 101) and cannot bind a privileged port. Port 80 here would
# have been a connection refused, not a redirect.
GATEWAY_DEV_UPSTREAM_ADMINUI_URL=http://admin-ui:8080
GATEWAY_DEV_UPSTREAM_CONFIG_URL=http://config:8080
GATEWAY_DEV_UPSTREAM_DASHBOARD_URL=http://dashboard:8080
GATEWAY_DEV_UPSTREAM_SESSION_URL=http://session:8080

# The staff identity domain: admin-auth (design/06-auth-identity-contract.md §5).
# These three names are fixed by the contract and shared with services/gateway,
# which needs the same domain for the two dev/staging patch manifest routes.
GATEWAY_STAFF_JWKS_URL=https://admin-auth.otomo.internal/.well-known/jwks.json
GATEWAY_STAFF_ISSUER=https://admin-auth.otomo.internal
GATEWAY_STAFF_AUDIENCE=otomo:staff

# Per-IP rate limiting (techspec §6.4). Enforced at the edge: /admin/ (the
# static SPA bundle) is unlimited, /admin-auth/ (the staff brute-force surface)
# uses the stricter login bucket, and every other route uses the general bucket.
# The sweeper evicts idle per-IP entries so the map cannot grow without bound.
GATEWAY_DEV_RATE_LIMIT_RPS=20
GATEWAY_DEV_RATE_LIMIT_BURST=40
GATEWAY_DEV_LOGIN_RATE_LIMIT_RPS=5
GATEWAY_DEV_LOGIN_RATE_LIMIT_BURST=10
GATEWAY_DEV_SWEEP_INTERVAL=5m
GATEWAY_DEV_MAX_IDLE_AGE=10m

# Optional TLS on the public listener. Both or neither.
GATEWAY_DEV_TLS_CERT_FILE=
GATEWAY_DEV_TLS_KEY_FILE=

GATEWAY_DEV_READ_TIMEOUT=10s
GATEWAY_DEV_WRITE_TIMEOUT=30s
GATEWAY_DEV_IDLE_TIMEOUT=120s

# Leeway on exp/nbf when validating staff tokens.
GATEWAY_DEV_JWT_CLOCK_SKEW=30s

# Set to 1 for human-readable logs. Local development only.
GATEWAY_DEV_LOG_PRETTY=
