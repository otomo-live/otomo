FROM golang:1.27.1-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
ARG GIT_SHA=dev
RUN --mount=type=cache,target=/go/pkg/mod --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w -X main.version=${GIT_SHA}" -o /out/gameplay_proxy .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/gameplay_proxy /gameplay_proxy
EXPOSE 27000/udp 9090
ENTRYPOINT ["/gameplay_proxy"]
