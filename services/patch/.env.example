# Patch service configuration.
# Copy to .env for local runs. In deployment these arrive through the
# Jenkins credential-backed env file (COM-9); no real secret goes in the repo.

# Public listener. Gateway proxies /patch/v1/* here, prefix intact. Patch has no
# route table yet: every public path is a COM-5 404 until PAT-B5.
PATCH_LISTEN_ADDR=:8080

# Internal listener: /healthz, /readyz, /metrics, /debug/pprof/. Never routed to from
# outside the compose network, and not published by the image.
PATCH_METRICS_ADDR=:9090

# Required. The read-only patch_ro role on Config's database. Patch never writes.
PATCH_DATABASE_URL=postgres://patch_ro:CHANGE_ME@postgres:5432/config

# COM-14 pool budget: keep the sum across services below Postgres max_connections.
PATCH_DB_MAX_CONNS=4

# Required. Config's blob volume, mounted read-only here. Patch only ever stats and
# serves from it; nginx sends the bytes (PAT-A2). Must exist and be a directory, or
# the service refuses to start.
PATCH_BLOB_ROOT=/var/lib/otomo/blobs

# Required. PHP Admin Auth's JWKS — not Auth's, which issues player tokens. The
# verifier is constructed now and counted by readiness; PAT-B6 wires it to the dev
# and staging manifest routes.
PATCH_STAFF_JWKS_URL=http://php-admin/.well-known/jwks.json
PATCH_STAFF_ISSUER=https://admin-auth.otomo.internal
PATCH_STAFF_AUDIENCE=otomo:staff

# How often the JWKS is re-fetched, and the leeway allowed on exp/nbf. The skew must
# cover the worst clock disagreement between this container and PHP Admin Auth; 0 is
# accepted, for a deployment whose containers share a clock source.
PATCH_STAFF_JWKS_REFRESH=30s
PATCH_JWT_CLOCK_SKEW=30s

# Fallback manifest poll interval (PAT-B4). NOTIFY makes this a safety net, not the
# primary path.
PATCH_POLL_INTERVAL=60s

PATCH_READ_TIMEOUT=10s
PATCH_WRITE_TIMEOUT=30s
PATCH_IDLE_TIMEOUT=120s
PATCH_SHUTDOWN_TIMEOUT=15s
PATCH_LOG_LEVEL=info

# Read only by the internal/store tests. Never set this in a deployment.
PATCH_TEST_DATABASE_URL=
