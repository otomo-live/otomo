# Allocator service configuration.
# Copy to .env for local runs. In deployment these arrive through the
# Jenkins credential-backed env file (COM-9); no real secret goes in the repo.

# Internal API listener. No Gateway route: only Session and game servers on the
# compose network call it, and every route authenticates with a service key.
ALLOCATOR_LISTEN_ADDR=:8080

# Internal listener: /healthz, /readyz, /metrics, /debug/pprof/. Never routed to from
# outside the compose network, and not published by the image.
ALLOCATOR_METRICS_ADDR=:9090

# Required. The allocator role on the shared Otomo database, schema-owned by this
# service (migrations/00001_init.sql).
ALLOCATOR_DATABASE_URL=postgres://allocator:CHANGE_ME@postgres:5432/allocator

# COM-14 pool budget: keep the sum across services below Postgres max_connections.
ALLOCATOR_DB_MAX_CONNS=8

ALLOCATOR_LOG_LEVEL=info

# Required by serve. PKCS#8 PEM, mounted read-only, readable by uid 65532. The
# Allocator signs the short-lived join tickets with it; generate one with
# `allocator genkey`. Rotate by pointing this at a new file and restarting serve.
ALLOCATOR_SIGNING_KEY_PATH=/run/secrets/allocator/signing_key.pem

# Required by serve. One base64url service key per role: Session's key authorises
# allocation requests, and the game-server key authorises registration and heartbeats.
# Separate files so one leaked secret does not have to be rotated in both directions.
ALLOCATOR_SESSION_KEY_PATH=/run/secrets/allocator_session.key
ALLOCATOR_GAMESERVER_KEY_PATH=/run/secrets/allocator_gameserver.key

# Required by serve. The key the Allocator presents when it calls Session back
# (design decision D4). Not used until callbacks land.
ALLOCATOR_CALLBACK_KEY_PATH=/run/secrets/session_allocator.key

# Session's Compose address, used for callback traffic. Never handed to a client.
ALLOCATOR_SESSION_URL=http://session:8081

# Required. The Gameplay Proxy's dialable host and port that a join ticket hands to a
# player. This is not the Allocator's own listener.
ALLOCATOR_PUBLIC_ADDRESS=gameplay.example.com
ALLOCATOR_PUBLIC_PORT=27000

# iss and aud on every join ticket. Both are checked by whoever validates the ticket,
# so they are configured rather than hardcoded.
ALLOCATOR_ISSUER=https://allocator.otomo.internal
ALLOCATOR_AUDIENCE=otomo:gameserver

# Ticket lifetime and reservation hold. Both are kept short on purpose: a reservation
# that outlives its party is a server nobody else can use.
ALLOCATOR_TICKET_TTL=60s
ALLOCATOR_RESERVATION_TTL=60s

# A game server is considered gone after HEARTBEAT_TIMEOUT without a heartbeat; the
# reaper looks every REAP_INTERVAL, which must be shorter than the timeout.
ALLOCATOR_HEARTBEAT_TIMEOUT=15s
ALLOCATOR_REAP_INTERVAL=5s

ALLOCATOR_READ_TIMEOUT=10s
ALLOCATOR_WRITE_TIMEOUT=10s
ALLOCATOR_IDLE_TIMEOUT=60s
ALLOCATOR_SHUTDOWN_TIMEOUT=15s
