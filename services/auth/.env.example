# Auth service configuration.
# Copy to .env for local runs. In deployment these arrive through the
# Jenkins credential-backed env file (COM-9); no real secret goes in the repo.

# Public listener. Gateway proxies /auth/* here.
AUTH_LISTEN_ADDR=:8080

# Internal listener: /healthz, /readyz, /metrics, /debug/pprof/.
AUTH_METRICS_ADDR=:9090

# Required by serve, migrate and genkey.
AUTH_DATABASE_URL=postgres://auth_rw:CHANGE_ME@postgres:5432/auth

# COM-14 pool budget: keep the sum across services below Postgres max_connections.
AUTH_DB_MAX_CONNS=8

# Required by serve. PKCS#8 PEM, mounted read-only, readable by uid 65532.
AUTH_SIGNING_KEY_PATH=/run/secrets/auth_signing_key.pem

# Must equal GATEWAY_PLAYER_ISSUER / GATEWAY_PLAYER_AUDIENCE exactly.
AUTH_ISSUER=https://auth.otomo.internal
AUTH_AUDIENCE=otomo:player

AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=720h

AUTH_READ_TIMEOUT=10s
AUTH_WRITE_TIMEOUT=30s
AUTH_IDLE_TIMEOUT=120s
AUTH_SHUTDOWN_TIMEOUT=15s
AUTH_LOG_LEVEL=info

# Read only by the internal/store tests. Never set this in a deployment.
AUTH_TEST_DATABASE_URL=
