# Dashboard service configuration.
# Copy to .env for local runs. In deployment these arrive through the
# Jenkins credential-backed env file (COM-9); no real secret goes in the repo.

# Public listener. Gateway proxies /api/admin/dashboard/* here, without stripping the
# prefix — this service's routes are registered at their external path.
DASHBOARD_LISTEN_ADDR=:8080

# Internal listener: /healthz, /readyz, /metrics, /debug/pprof/. Never routed to from
# outside the compose network, and not published by the image.
DASHBOARD_METRICS_ADDR=:9090

# Required. PHP Admin Auth's JWKS — the staff identity domain from
# 06-auth-identity-contract.md §3. Dashboard verifies every token against it and mints
# none of its own. The issuer and audience have defaults, but both are checked against the
# token's claims, never inferred from which JWKS answered.
DASHBOARD_STAFF_JWKS_URL=http://php-admin/.well-known/jwks.json
DASHBOARD_STAFF_ISSUER=https://admin-auth.otomo.internal
DASHBOARD_STAFF_AUDIENCE=otomo:staff

# How often the JWKS is re-fetched, and the leeway allowed on exp/nbf. The skew must cover
# the worst clock disagreement between this container and PHP Admin Auth; 0 is accepted,
# for a deployment whose containers share a clock source.
DASHBOARD_STAFF_JWKS_REFRESH=30s
DASHBOARD_JWT_CLOCK_SKEW=30s

# Query-time upstreams. Neither is checked at startup and neither is part of readiness: an
# unreachable store degrades the panels that need it, it does not take the Dashboard out of
# rotation (DSH-D8).
DASHBOARD_PROMETHEUS_URL=http://prometheus:9090
DASHBOARD_LOKI_URL=http://loki:3100
# Base URLs of the two audit feeds behind GET /audit. The merged handler appends
# /api/admin/config/audit and /admin-auth/audit and forwards the caller's own bearer token;
# a feed that is down degrades the page rather than the process.
DASHBOARD_CONFIG_URL=http://config:8080
DASHBOARD_ADMIN_AUTH_URL=http://admin-auth:8080
DASHBOARD_SESSION_URL=http://session:8080
DASHBOARD_UPSTREAM_TIMEOUT=2s

# Service health prober. DASHBOARD_TARGETS is a comma-separated list of name=url pairs,
# where the url is a service's internal base URL; the prober polls <url>/readyz. Names
# match ^[a-z][a-z0-9_]{0,31}$ and must be unique. Empty is valid (no targets).
DASHBOARD_TARGETS=auth=http://auth:9090,config=http://config:9090,patch=http://patch:9090
# How often every target is re-probed; must be at least 1s.
DASHBOARD_PROBE_INTERVAL=15s

DASHBOARD_READ_TIMEOUT=10s
DASHBOARD_WRITE_TIMEOUT=30s
DASHBOARD_IDLE_TIMEOUT=120s
DASHBOARD_SHUTDOWN_TIMEOUT=15s
DASHBOARD_LOG_LEVEL=info
