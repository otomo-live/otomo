cpu	sum(rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_service="gateway"}[300s]))
error_ratio	sum(rate({__name__=~".+_http_requests_total",service="gateway",status=~"5.."}[300s])) / clamp_min(sum(rate({__name__=~".+_http_requests_total",service="gateway"}[300s])), 1e-9)
gc_pause_max	max(go_gc_duration_seconds{service="gateway",quantile="1"})
goroutines	sum(go_goroutines{service="gateway"})
heap_inuse	sum(go_memstats_heap_inuse_bytes{service="gateway"})
latency_p50	histogram_quantile(0.50, sum by (le) (rate({__name__=~".+_http_request_duration_seconds_bucket",service="gateway"}[300s])))
latency_p95	histogram_quantile(0.95, sum by (le) (rate({__name__=~".+_http_request_duration_seconds_bucket",service="gateway"}[300s])))
latency_p99	histogram_quantile(0.99, sum by (le) (rate({__name__=~".+_http_request_duration_seconds_bucket",service="gateway"}[300s])))
memory	sum(container_memory_working_set_bytes{container_label_com_docker_compose_service="gateway"})
rps_by_status	sum by (class) (label_replace(rate({__name__=~".+_http_requests_total",service="gateway"}[300s]), "class", "${1}xx", "status", "([0-9]).."))
